# ============ TMDB ============
# TMDB API key (v3): https://www.themoviedb.org/settings/api
TMDB_API_KEY=changeme
# Metadata language and region used for releases and streaming providers.
TMDB_LANGUAGE=en-US
TMDB_REGION=US

# ============ Radarr ============
# URL of your Radarr instance, as seen from inside the container.
# If Radarr also runs in Docker on the same host, use its service name
# or http://host.docker.internal:7878
RADARR_URL=http://host.docker.internal:7878
RADARR_API_KEY=changeme

# ============ Defaults when adding to Radarr (optional) ============
# Leave empty to pick in the UI / fall back to the first profile and root folder.
RADARR_QUALITY_PROFILE_ID=
RADARR_ROOT_FOLDER=
RADARR_MINIMUM_AVAILABILITY=released
RADARR_MONITOR=true
RADARR_SEARCH_ON_ADD=true

# ============ Sonarr (TV shows) ============
# URL of your Sonarr instance, as seen from inside the container.
SONARR_URL=http://host.docker.internal:8989
SONARR_API_KEY=changeme

# ============ Defaults when adding to Sonarr (optional) ============
SONARR_QUALITY_PROFILE_ID=
SONARR_ROOT_FOLDER=
SONARR_MONITOR=true
SONARR_SEARCH_ON_ADD=true
# standard | anime | daily
SONARR_SERIES_TYPE=standard
# Create one folder per season
SONARR_SEASON_FOLDER=true

# ============ Mistral AI (voice assistant, optional) ============
# Mistral API key: https://console.mistral.ai/
# Leave empty and the voice assistant button stays hidden.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# Language the assistant answers in. Empty = derived from TMDB_LANGUAGE.
ASSISTANT_LANGUAGE=

# ============ Auto-lists ============
# Where lists.json is persisted (mounted as a volume in docker-compose).
DATA_DIR=/data
# How often each list is re-scanned, in hours.
LIST_REFRESH_HOURS=12
# TMDB pages scanned per run (~20 titles per page).
LIST_MAX_PAGES=3

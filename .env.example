# ============ TMDB ============
# Clé API TMDB (v3) : https://www.themoviedb.org/settings/api
TMDB_API_KEY=changeme
TMDB_LANGUAGE=fr-FR
TMDB_REGION=FR

# ============ Radarr ============
# URL de ton instance Radarr (depuis le conteneur).
# Si Radarr tourne aussi en docker sur le même hôte, utilise son nom de service
# ou http://host.docker.internal:7878
RADARR_URL=http://host.docker.internal:7878
RADARR_API_KEY=changeme

# ============ Valeurs par défaut à l'ajout (optionnel) ============
# Laisse vide pour laisser l'utilisateur choisir / utiliser le 1er profil & dossier.
RADARR_QUALITY_PROFILE_ID=
RADARR_ROOT_FOLDER=
RADARR_MINIMUM_AVAILABILITY=released
RADARR_MONITOR=true
RADARR_SEARCH_ON_ADD=true
